{
  "name": "laraorvite/framework",
  "description": "Custom frontend and API starter for Laravel",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "LaraOrVite\\Framework\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "LaraOrVite\\Framework\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "LaraOrVite\\Framework\\FrontendServiceProvider"
      ]
    }
  },
  "require": {
    "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
    "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
    "illuminate/filesystem": "^10.0|^11.0|^12.0|^13.0",
    "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
    "illuminate/routing": "^10.0|^11.0|^12.0|^13.0"
  },
  "require-dev": {
    "orchestra/testbench": "^11.0"
  }
}
